<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <title>Admin Panel - Zanskar Hostel Mess</title>
    <link rel="stylesheet" href="/styles.css" />
    <script>
      const currentMenu = JSON.parse(
        decodeURIComponent(
          "<%- encodeURIComponent(JSON.stringify(mealPlan)) %>"
        )
      );
      function updateMenuText() {
        const day = document.getElementById("day").value;
        const meal = document.getElementById("meal").value;
        const menuText = document.getElementById("menu-text");
        if (currentMenu[day] && currentMenu[day][meal]) {
          menuText.value = currentMenu[day][meal];
        } else {
          menuText.value = "";
        }
      }
    </script>
  </head>
  <body>
    <header>
      <div class="navbar">
        <div class="nav-title">Admin Panel</div>
        <div class="actions-inline">
          <a href="/" class="theme-toggle">Site</a>
          <a href="/logout" class="theme-toggle">Logout</a>
          <button id="themeToggle" class="theme-toggle" type="button">
            Theme
          </button>
        </div>
      </div>
    </header>
    <main class="container fade-in">
      <div class="grid grid-2">
        <!-- Column 1 -->
        <div class="card" style="grid-column: 1 / -1">
          <h2>Update Menu</h2>
          <form action="/update-menu" method="POST" class="menu-form-stacked">
            <label for="day">Day</label>
            <select id="day" name="day" onchange="updateMenuText()" required>
              <option value="">Select</option>
              <option value="monday">Monday</option>
              <option value="tuesday">Tuesday</option>
              <option value="wednesday">Wednesday</option>
              <option value="thursday">Thursday</option>
              <option value="friday">Friday</option>
              <option value="saturday">Saturday</option>
              <option value="sunday">Sunday</option>
            </select>
            <label for="meal">Meal</label>
            <select id="meal" name="meal" onchange="updateMenuText()" required>
              <option value="">Select</option>
              <option value="breakfast">Breakfast</option>
              <option value="lunch">Lunch</option>
              <option value="snacks">Evening Snacks</option>
              <option value="dinner">Dinner</option>
            </select>
            <label for="menu-text">Menu</label>
            <textarea
              id="menu-text"
              name="menu"
              rows="3"
              placeholder="Enter menu..."
              required
            ></textarea>
            <div
              id="menu-count"
              style="
                font-size: 0.6rem;
                color: var(--text-soft);
                margin-top: -0.3rem;
              "
            ></div>
            <button type="submit" class="btn-wide">Save Menu</button>
          </form>
        </div>

        <div class="card span-full">
          <h2>Announcements (<%= announcements.length %>)</h2>
          <form action="/add-announcement" method="POST">
            <label for="announcement">New</label>
            <textarea
              id="announcement"
              name="announcement"
              rows="2"
              required
            ></textarea>
            <div class="actions-inline" style="justify-content: flex-end">
              <button type="submit">Add</button>
            </div>
          </form>
          <div
            class="table-wrapper"
            style="margin-top: 0.85rem; max-height: 260px; overflow: auto"
          >
            <table class="table-compact">
              <thead>
                <tr>
                  <th>Announcement</th>
                  <th style="width: 68px">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if(announcements.length===0){ %>
                <tr>
                  <td colspan="2" style="font-size: 0.65rem">None yet.</td>
                </tr>
                <% } %> <% announcements.forEach(function(announcement){ %>
                <tr>
                  <td style="font-size: 0.68rem; line-height: 1.25">
                    <%= announcement.announcement %>
                  </td>
                  <td>
                    <form
                      action="/delete-announcement"
                      method="POST"
                      class="inline-form"
                    >
                      <input
                        type="hidden"
                        name="id"
                        value="<%= announcement.id %>"
                      />
                      <button
                        type="submit"
                        class="btn-danger"
                        style="font-size: 0.55rem; padding: 0.38rem 0.55rem"
                      >
                        Del
                      </button>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Column 2 full width via grid order when stacked -->
        <div class="card" style="grid-column: 1 / -1">
          <h2 style="margin-bottom: 0.75rem">Feedback</h2>
          <div class="tabs" data-tabs>
            <div class="tab-list" role="tablist">
              <button
                class="tab active"
                role="tab"
                aria-selected="true"
                data-tab-target="complaints"
              >
                Complaints (<%= complaints.length %>)
              </button>
              <button
                class="tab"
                role="tab"
                aria-selected="false"
                data-tab-target="suggestions"
              >
                Suggestions (<%= suggestions.length %>)
              </button>
            </div>
            <div class="tab-panels">
              <div id="tab-complaints" class="tab-panel" role="tabpanel">
                <div
                  class="table-wrapper"
                  style="max-height: 340px; overflow: auto"
                >
                  <table class="table-compact">
                    <thead>
                      <tr>
                        <th>Date (IST)</th>
                        <th>Meal</th>
                        <th>Name</th>
                        <th>Mobile</th>
                        <th>Complaint</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if(complaints.length===0){ %>
                      <tr>
                        <td colspan="5" style="font-size: 0.65rem">
                          No complaints.
                        </td>
                      </tr>
                      <% } %> <% complaints.forEach(function(complaint){ let
                      complaintDate = new Date(complaint.date);
                      complaintDate.setMinutes(complaintDate.getMinutes()+330);
                      let formattedDate =
                      complaintDate.toLocaleDateString('en-IN',{ month:'short',
                      day:'numeric', hour:'2-digit', minute:'2-digit'}); %>
                      <tr>
                        <td><%= formattedDate %></td>
                        <td><%= complaint.meal %></td>
                        <td><%= complaint.name %></td>
                        <td><%= complaint.mobile %></td>
                        <td style="max-width: 220px; white-space: pre-wrap">
                          <%= complaint.complaint %>
                        </td>
                      </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
              <div
                id="tab-suggestions"
                class="tab-panel"
                role="tabpanel"
                hidden
              >
                <div
                  class="table-wrapper"
                  style="max-height: 340px; overflow: auto"
                >
                  <table class="table-compact">
                    <thead>
                      <tr>
                        <th>Date (IST)</th>
                        <th>Suggestion</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if(suggestions.length===0){ %>
                      <tr>
                        <td colspan="2" style="font-size: 0.65rem">
                          No suggestions.
                        </td>
                      </tr>
                      <% } %> <% suggestions.forEach(function(suggestion){ let
                      suggestionDate = new Date(suggestion.date);
                      suggestionDate.setMinutes(suggestionDate.getMinutes()+330);
                      let formattedDate =
                      suggestionDate.toLocaleDateString('en-IN',{ month:'short',
                      day:'numeric', hour:'2-digit', minute:'2-digit'}); %>
                      <tr>
                        <td style="white-space: nowrap">
                          <%= formattedDate %>
                        </td>
                        <td style="max-width: 360px; white-space: pre-wrap">
                          <%= suggestion.suggestion %>
                        </td>
                      </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
    <script>
      const toggleBtn = document.getElementById("themeToggle");
      const root = document.documentElement;
      (function () {
        const saved = localStorage.getItem("theme");
        if (saved === "dark") root.classList.add("dark");
      })();
      toggleBtn.addEventListener("click", () => {
        root.classList.toggle("dark");
        localStorage.setItem(
          "theme",
          root.classList.contains("dark") ? "dark" : "light"
        );
      });
      // Tabs
      document.querySelectorAll("[data-tabs]").forEach((tabs) => {
        const buttons = tabs.querySelectorAll(".tab");
        const panels = tabs.querySelectorAll(".tab-panel");
        buttons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const target = btn.getAttribute("data-tab-target");
            buttons.forEach((b) => {
              b.classList.toggle("active", b === btn);
              b.setAttribute("aria-selected", b === btn);
            });
            panels.forEach((p) => {
              p.hidden = !p.id.endsWith(target);
            });
          });
        });
      });
      // Menu counter
      const menuTa = document.getElementById("menu-text");
      const menuCount = document.getElementById("menu-count");
      if (menuTa && menuCount) {
        const updateCount = () => {
          menuCount.textContent = menuTa.value.length + " chars";
        };
        menuTa.addEventListener("input", updateCount);
        updateCount();
      }
    </script>
  </body>
</html>
