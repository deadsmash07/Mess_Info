<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <title>Admin Panel - Zanskar Hostel Mess</title>
    <link rel="stylesheet" href="/styles.css" />
    <script>
      const currentMenu = JSON.parse(
        decodeURIComponent(
          "<%- encodeURIComponent(JSON.stringify(mealPlan)) %>"
        )
      );
      function updateMenuText() {
        const day = document.getElementById("day").value;
        const meal = document.getElementById("meal").value;
        const menuText = document.getElementById("menu-text");
        if (currentMenu[day] && currentMenu[day][meal]) {
          menuText.value = currentMenu[day][meal];
        } else {
          menuText.value = "";
        }
      }
    </script>
  </head>
  <body>
    <header>
      <div class="navbar">
        <div class="nav-title">Admin Panel</div>
        <div class="actions-inline">
          <a href="/" class="theme-toggle">Site</a>
          <a href="/logout" class="theme-toggle">Logout</a>
          <button id="themeToggle" class="theme-toggle" type="button">
            Theme
          </button>
        </div>
      </div>
    </header>
    <main class="container fade-in">
      <div class="grid grid-2">
        <div class="card">
          <h2>Update Menu</h2>
          <form action="/update-menu" method="POST">
            <label for="day">Day</label>
            <select id="day" name="day" onchange="updateMenuText()" required>
              <option value="">Select</option>
              <option value="monday">Monday</option>
              <option value="tuesday">Tuesday</option>
              <option value="wednesday">Wednesday</option>
              <option value="thursday">Thursday</option>
              <option value="friday">Friday</option>
              <option value="saturday">Saturday</option>
              <option value="sunday">Sunday</option>
            </select>
            <label for="meal">Meal</label>
            <select id="meal" name="meal" onchange="updateMenuText()" required>
              <option value="">Select</option>
              <option value="breakfast">Breakfast</option>
              <option value="lunch">Lunch</option>
              <option value="snacks">Evening Snacks</option>
              <option value="dinner">Dinner</option>
            </select>
            <label for="menu-text">Menu</label>
            <textarea
              id="menu-text"
              name="menu"
              rows="2"
              placeholder="Enter menu..."
              required
            ></textarea>
            <button type="submit">Save Menu</button>
          </form>
        </div>

        <div class="card">
          <h2>Announcements</h2>
          <form action="/add-announcement" method="POST">
            <label for="announcement">New Announcement</label>
            <textarea
              id="announcement"
              name="announcement"
              rows="3"
              required
            ></textarea>
            <button type="submit">Add</button>
          </form>
          <hr />
          <h3 style="margin-top: 0.25rem">Current</h3>
          <div class="table-wrapper" style="margin-top: 0.5rem">
            <table>
              <thead>
                <tr>
                  <th>Announcement</th>
                  <th style="width: 90px">Action</th>
                </tr>
              </thead>
              <tbody>
                <% announcements.forEach(function(announcement){ %>
                <tr>
                  <td style="font-size: 0.75rem; line-height: 1.25">
                    <%= announcement.announcement %>
                  </td>
                  <td>
                    <form
                      action="/delete-announcement"
                      method="POST"
                      class="inline-form"
                    >
                      <input
                        type="hidden"
                        name="id"
                        value="<%= announcement.id %>"
                      />
                      <button
                        type="submit"
                        class="btn-danger"
                        style="font-size: 0.65rem; padding: 0.45rem 0.6rem"
                      >
                        Delete
                      </button>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="card">
          <h2>Complaints</h2>
          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>Date & Time (IST)</th>
                  <th>Meal</th>
                  <th>Name</th>
                  <th>Mobile</th>
                  <th>Complaint</th>
                </tr>
              </thead>
              <tbody>
                <% complaints.forEach(function(complaint){ let complaintDate =
                new Date(complaint.date);
                complaintDate.setMinutes(complaintDate.getMinutes()+330); let
                formattedDate = complaintDate.toLocaleDateString('en-IN',{
                weekday:'short',year:'numeric',month:'short',day:'numeric',
                hour:'2-digit',minute:'2-digit',second:'2-digit' }); %>
                <tr>
                  <td><%= formattedDate %></td>
                  <td><%= complaint.meal %></td>
                  <td><%= complaint.name %></td>
                  <td><%= complaint.mobile %></td>
                  <td style="max-width: 200px; white-space: pre-wrap">
                    <%= complaint.complaint %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="card">
          <h2>Suggestions</h2>
          <div class="table-wrapper">
            <table>
              <thead>
                <tr>
                  <th>Date & Time (IST)</th>
                  <th>Suggestion</th>
                </tr>
              </thead>
              <tbody>
                <% suggestions.forEach(function(suggestion){ let suggestionDate
                = new Date(suggestion.date);
                suggestionDate.setMinutes(suggestionDate.getMinutes()+330); let
                formattedDate = suggestionDate.toLocaleDateString('en-IN',{
                weekday:'short',year:'numeric',month:'short',day:'numeric',
                hour:'2-digit',minute:'2-digit',second:'2-digit' }); %>
                <tr>
                  <td><%= formattedDate %></td>
                  <td style="max-width: 300px; white-space: pre-wrap">
                    <%= suggestion.suggestion %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
    <script>
      const toggleBtn = document.getElementById("themeToggle");
      const root = document.documentElement;
      (function () {
        const saved = localStorage.getItem("theme");
        if (saved === "dark") root.classList.add("dark");
      })();
      toggleBtn.addEventListener("click", () => {
        root.classList.toggle("dark");
        localStorage.setItem(
          "theme",
          root.classList.contains("dark") ? "dark" : "light"
        );
      });
    </script>
  </body>
</html>
