<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <title>Zanskar Hostel Mess</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header>
      <div class="navbar">
        <div class="nav-title">Zanskar Mess</div>
        <button
          id="themeToggle"
          class="theme-toggle"
          type="button"
          aria-label="Toggle theme"
        >
          Theme
        </button>
      </div>
    </header>
    <main class="container fade-in">
      <h1>Mess Information Portal</h1>

      <div class="card">
        <h2>
          Weekly Meal Plan <% if (lastUpdated) { %><span class="badge"
            >Updated</span
          ><% } %>
        </h2>
        <% if (lastUpdated) { %>
        <small class="muted">Menu last changed: <%= lastUpdated %></small>
        <% } %>
        <div
          class="table-wrapper meal-table-wrapper"
          role="region"
          aria-label="Weekly Meal Plan"
          tabindex="0"
        >
          <table>
            <thead>
              <tr>
                <th scope="col">Day</th>
                <th scope="col">Breakfast</th>
                <th scope="col">Lunch</th>
                <th scope="col">Evening Snacks</th>
                <th scope="col">Dinner</th>
              </tr>
            </thead>
            <tbody>
              <%
              ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'].forEach(function(day){
              %>
              <tr>
                <th scope="row">
                  <%= day.charAt(0).toUpperCase()+day.slice(1) %>
                </th>
                <td>
                  <%= mealPlan[day] && mealPlan[day].breakfast ?
                  mealPlan[day].breakfast : '' %>
                </td>
                <td>
                  <%= mealPlan[day] && mealPlan[day].lunch ? mealPlan[day].lunch
                  : '' %>
                </td>
                <td>
                  <%= mealPlan[day] && mealPlan[day].snacks ?
                  mealPlan[day].snacks : '' %>
                </td>
                <td>
                  <%= mealPlan[day] && mealPlan[day].dinner ?
                  mealPlan[day].dinner : '' %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <!-- Mobile card view -->
        <div class="meal-cards" aria-label="Weekly Meal Plan (mobile)">
          <%
          ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'].forEach(function(day){
          %>
          <div class="meal-card">
            <h3><%= day.charAt(0).toUpperCase()+day.slice(1) %></h3>
            <div class="meal-items">
              <div class="meal-row">
                <span class="label">Breakfast</span>
                <span
                  ><%= mealPlan[day] && mealPlan[day].breakfast ?
                  mealPlan[day].breakfast : '-' %></span
                >
              </div>
              <div class="meal-row">
                <span class="label">Lunch</span>
                <span
                  ><%= mealPlan[day] && mealPlan[day].lunch ?
                  mealPlan[day].lunch : '-' %></span
                >
              </div>
              <div class="meal-row">
                <span class="label">Snacks</span>
                <span
                  ><%= mealPlan[day] && mealPlan[day].snacks ?
                  mealPlan[day].snacks : '-' %></span
                >
              </div>
              <div class="meal-row">
                <span class="label">Dinner</span>
                <span
                  ><%= mealPlan[day] && mealPlan[day].dinner ?
                  mealPlan[day].dinner : '-' %></span
                >
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      </div>

      <div class="grid grid-2" style="margin-top: 1.25rem">
        <div class="card">
          <h2>Announcements</h2>
          <% if (announcements.length) {
          announcements.forEach(function(announcement){ let d = new
          Date(announcement.created_at); d.setMinutes(d.getMinutes()+330); let
          formatted = d.toLocaleDateString('en-IN',{
          month:'short',day:'numeric', hour:'2-digit',minute:'2-digit' }); %>
          <div class="announcement">
            <p><%= announcement.announcement %></p>
            <time datetime="<%= d.toISOString() %>">[<%= formatted %>]</time>
          </div>
          <% }) } else { %>
          <div class="announcement"><p>No announcements yet.</p></div>
          <% } %>
        </div>

        <div class="card">
          <h2>Suggestion Box</h2>
          <form
            action="/submit-suggestion"
            method="POST"
            onsubmit="return validateSuggestion()"
            novalidate
          >
            <label for="suggestion">Your Suggestion</label>
            <textarea
              id="suggestion"
              name="suggestion"
              placeholder="Type your suggestion..."
              required
            ></textarea>
            <button type="submit">Submit Suggestion</button>
          </form>
          <hr />
          <h2 style="margin-top: 0.25rem">Complaint Box</h2>
          <form action="/submit-complaint" method="POST" novalidate>
            <div class="flex-row">
              <div style="flex: 1 1 140px; min-width: 140px">
                <label for="complaint-date">Date</label>
                <input type="date" id="complaint-date" name="date" required />
              </div>
              <div style="flex: 1 1 160px; min-width: 160px">
                <label for="meal-type">Meal</label>
                <select id="meal-type" name="meal" required>
                  <option value="breakfast">Breakfast</option>
                  <option value="lunch">Lunch</option>
                  <option value="snacks">Evening Snacks</option>
                  <option value="dinner">Dinner</option>
                </select>
              </div>
            </div>
            <label for="complaint-name">Name</label>
            <input
              type="text"
              id="complaint-name"
              name="name"
              placeholder="Your name"
              required
            />
            <label for="complaint-mobile">Mobile</label>
            <input
              type="tel"
              id="complaint-mobile"
              name="mobile"
              placeholder="10-digit number"
              pattern="[0-9]{10}"
              required
            />
            <label for="complaint">Complaint</label>
            <textarea
              id="complaint"
              name="complaint"
              placeholder="Describe the issue..."
              required
            ></textarea>
            <button type="submit">Submit Complaint</button>
          </form>
        </div>
      </div>

      <div class="card" style="margin-top: 1.25rem">
        <h2>General Guidelines</h2>
        <ul class="guidelines">
          <li>
            Mess
            <a
              href="https://docs.google.com/document/d/1grdzadpO3sVbroGn8cWwYpPbLevUjl-T9LhWsF_lkXQ/edit"
              target="_blank"
              rel="noopener"
              >SOP</a
            >
            for Self-kitchen.
          </li>
          <li>
            Extra messing in lunch (till 1:30 PM) daily* except Wed, Sat, Sun.
          </li>
          <li>Maintain cleanliness; dispose waste properly.</li>
          <li>Inform in advance for special dietary needs.</li>
          <li>Collect coupons to avail extra-messing benefits.</li>
          <li>Dinner after 9:05 PM only for sports persons.</li>
          <li>Report issues (quality/foreign objects) immediately.</li>
        </ul>
        <div class="disclaimer">
          This site is informational; menu and details may change. *Extra
          messing subject to workload and availability.
        </div>
      </div>

      <footer>
        &copy; 2024
        <a href="https://github.com/deadsmash07" target="_blank" rel="noopener"
          >Arnav Raj</a
        >
        - Ex-Mess Secretary, Zanskar Hostel, IIT Delhi
      </footer>
    </main>
    <script>
      function validateSuggestion() {
        const el = document.getElementById("suggestion");
        if (!el.value.trim()) {
          alert("Suggestion cannot be empty");
          el.focus();
          return false;
        }
        return true;
      }
      const toggleBtn = document.getElementById("themeToggle");
      const root = document.documentElement;
      (function initTheme() {
        const saved = localStorage.getItem("theme");
        if (saved === "dark") root.classList.add("dark");
      })();
      toggleBtn.addEventListener("click", () => {
        root.classList.toggle("dark");
        localStorage.setItem(
          "theme",
          root.classList.contains("dark") ? "dark" : "light"
        );
      });
    </script>
  </body>
</html>
